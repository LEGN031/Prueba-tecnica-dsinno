# ==========================================
# Configuración del Servicio API REST
# ==========================================
url_base=https://jsonplaceholder.typicode.com/posts
timeout=5
max_retries=3
backoff_factor=1.0

# ==========================================
# Rutas de Archivos y Bases de Datos
# ==========================================
input_csv=cuentas.csv
output_excel=output/resultado.xlsx
db_state=state/estado.db
log_file=logs/proceso.log
